# =============================================================================
# WebMind environment configuration
# =============================================================================
# Copy to `.env` (repo root) and fill in the values. `.env` is git-ignored.
# The sidecar server reads this file on startup (see sidecar/load-env.js).
#
# These variables are ONLY needed when you turn on the "Cloud LLaMA" and/or
# "Cloud LLaVA" switches in the extension settings. With both switches off,
# WebMind runs fully locally through Ollama and none of this is required.
#
# Nomic text embeddings ALWAYS run locally and are never configured here.
# -----------------------------------------------------------------------------

# One shared API key, used for BOTH endpoints below (sent as the `x-api-key`
# header). Never commit the real value.
AWS_API_KEY=

# Two DIFFERENT endpoints, one per model. OpenAI-compatible Chat Completions.
LLAMA_API_URL=
LLAVA_API_URL=

# -----------------------------------------------------------------------------
# Optional overrides (sensible defaults are used if unset)
# -----------------------------------------------------------------------------
# AWS_LLAMA_MODEL=llama-3.2-3b
# AWS_LLAVA_MODEL=llava
# AWS_API_KEY_HEADER=x-api-key
# AWS_TIMEOUT_MS=30000
